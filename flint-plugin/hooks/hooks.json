{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "flint session-start --session \"$(jq -r '.session_id // empty' 2>/dev/null)\" 2>/dev/null || true",
            "timeout": 2
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "flint session-end --session \"$(jq -r '.session_id // empty' 2>/dev/null)\" 2>/dev/null || true",
            "timeout": 2
          }
        ]
      }
    ],
    "PostCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "flint compact 2>/dev/null || true",
            "timeout": 2
          }
        ]
      }
    ]
  }
}
