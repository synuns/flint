{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "eval \"flint session-start --session $(jq -r '.session_id // \"\" | @sh' 2>/dev/null)\" 2>/dev/null || true",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "eval \"flint session-end --session $(jq -r '.session_id // \"\" | @sh' 2>/dev/null)\" 2>/dev/null || true",
            "timeout": 10
          }
        ]
      }
    ],
    "PostCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "flint compact 2>/dev/null || true",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
