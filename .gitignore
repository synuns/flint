# Doltgres data (버전 이력은 dolt가 관리)
data/*

# 빌드 산출물
dist/
bin/flint

# 로그·환경
*.log
.env
.pgpass

# flint seed files are source-controlled; only runtime data is ignored
!data/seed.jsonl
!data/seed_test.go

# 하네스 로컬 계층(개인 지침·로컬 훅) — repo 미커밋
CLAUDE.local.md
.claude/settings.local.json

# flint 백업 덤프 실수 반입 방지(v0.28.2) — 자동 명명 덤프+사이드카.
# 기본 백업 디렉터리는 ~/.flint/backup(repo 밖).
flint-*.sql*

# 릴리스 서명 키 — repo 안 두지 않는다(백업은 ~/.config/flint/)
release.key
release.pub
